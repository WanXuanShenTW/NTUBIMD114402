<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <!-- 分隔線：放在 headerBrand 下方；沒有 headerBrand 就改成 Top_toTopOf="parent" -->
    <View
        android:id="@+id/titleDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerBrand"
        android:layout_marginTop="14dp" />

    <TextView
        android:id="@+id/textTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="狀態報告"
        android:textColor="#333333"
        android:textStyle="normal"
        android:textSize="22sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtSelectedElder"
        android:layout_marginTop="15dp" />

    <!-- 右上登出 -->

    <!-- 左上角 Logo + 標題 -->
    <ImageButton
        android:id="@+id/btnLogout"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_margin="25dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:background="@android:color/transparent"
        android:contentDescription="登出"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_power"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/headerBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="18dp"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/logo"
            android:contentDescription="品牌標誌" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI底家"
            android:textSize="20sp"
            android:layout_marginTop="5dp"
            android:textColor="#333333" />
    </LinearLayout>


    <!-- 下拉式文字選單 -->
    <TextView
        android:id="@+id/txtSelectedElder"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="25dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/edittext_rounded_bg"
        android:padding="12dp"
        android:text="選擇被照護者"
        android:gravity="center_vertical|start"
        android:textSize="16sp"
        android:textColor="#333333"
        android:drawableEnd="@drawable/ic_down"
        android:drawableRight="@drawable/ic_down"
        app:layout_constraintTop_toBottomOf="@id/titleDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- RecyclerView 被照護者列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewElder"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="20dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/textTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ScrollView -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/recyclerViewElder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="25dp">

            <!-- 客廳按鈕 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:clipToOutline="true"
                android:background="@drawable/card_background">

                <ImageButton
                    android:id="@+id/btnLivingRoom"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/living_room"
                    android:contentDescription="客廳" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#66000000" />

                <ImageView
                    android:id="@+id/iconCamera"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_camera"
                    android:contentDescription="攝影機"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" 進入畫面"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="15dp"
                    android:shadowColor="#80000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4" />
            </FrameLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="66dp"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:weightSum="4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 設定：放到最左邊，沿用 btnmenu -->
        <ImageButton
            android:id="@+id/btnmenu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:contentDescription="設定"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_menu"
            android:translationY="2dp"/>

        <ImageButton
            android:id="@+id/navSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:contentDescription="查詢列表"
            android:padding="16dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_search" />

        <ImageButton
            android:id="@+id/navChat"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="@null"
            android:contentDescription="對話"
            android:padding="12dp"
            android:layout_marginTop="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_chat" />

        <ImageButton
            android:id="@+id/navEmergency"
            android:layout_width="0dp"
            android:layout_height="51dp"
            android:layout_weight="1"
            android:background="@null"
            android:contentDescription="緊急聯絡人"
            android:padding="9dp"
            android:layout_marginTop="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_emergency" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
