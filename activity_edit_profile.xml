<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:gravity="center_horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="4dp">

            <ImageView
                android:id="@+id/btnCancel"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="返回"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="主選單"
                android:textSize="20sp"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="4dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginLeft="14dp"
            android:layout_marginRight="14dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="個人檔案"
            android:textSize="22sp"
            android:textColor="#333333"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/card_background"
                android:elevation="6dp"
                android:layout_marginBottom="15dp">

                <!-- 姓名 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="姓名"
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="5dp" />

                <EditText
                    android:id="@+id/editName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edittext_background"
                    android:hint="請輸入姓名"
                    android:padding="12dp"
                    android:enabled="false"
                    android:maxLines="1"
                    android:inputType="textPersonName"/>

                <!-- 角色 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="角色"
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="5dp" />

                <Spinner
                    android:id="@+id/spinnerRole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edittext_background"
                    android:padding="12dp"
                    android:enabled="false" />

                <!-- 手機 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="手機號碼"
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="5dp" />

                <TextView
                    android:id="@+id/textPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:background="@drawable/edittext_gray_background"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:layout_marginBottom="16dp"
                    android:text="09xxxxxxxx"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <!-- 地址 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="地址"
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="5dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/section_outline"
                    android:padding="12dp"
                    android:orientation="vertical">

                    <!-- 城市/地區 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="8dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="城市"
                                android:textSize="14sp"
                                android:layout_marginBottom="4dp"/>

                            <Spinner
                                android:id="@+id/spinnerCity"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/edittext_background"
                                android:padding="8dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="8dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="地區"
                                android:textSize="14sp"
                                android:layout_marginBottom="4dp"/>

                            <Spinner
                                android:id="@+id/spinnerDistrict"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/edittext_background"
                                android:padding="8dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <EditText
                        android:id="@+id/editAddressLine"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="地址（路名、號、樓層）"
                        android:inputType="textPostalAddress|textMultiLine"
                        android:minLines="1"
                        android:maxLines="2"
                        android:gravity="top|start"
                        android:background="@drawable/edittext_underline"
                        android:backgroundTint="@null"
                        android:paddingTop="10dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="0dp"
                        android:paddingBottom="6dp"
                        android:layout_marginBottom="8dp"
                        android:layout_marginTop="10dp" />
                </LinearLayout>

                <!-- 底部按鈕 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="24dp">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnChangePassword"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/button_white_border_black"
                        android:text="修改密碼"
                        android:textColor="#000000"
                        android:textSize="18sp"/>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnDeleteAccount"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/button_white_border_black"
                        android:text="刪除帳號"
                        android:textColor="#000000"
                        android:textSize="18sp"/>
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSave"
                    android:layout_width="160dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="25dp"
                    android:background="@drawable/button_rounded_black"
                    android:text="儲存"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:enabled="false"/>

                <!-- 加入 LINE 官方帳號 -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnAddLine"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/button_line_green"
                    android:text="加入 LINE 官方帳號"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:drawablePadding="8dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"/>

            </LinearLayout>

            <TextView
                android:id="@+id/btnEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ 編輯"
                android:textColor="#000000"
                android:textSize="14sp"
                android:padding="10dp"
                android:layout_gravity="top|end"
                android:layout_margin="5dp"
                android:elevation="12dp"/>

            <ProgressBar
                android:id="@+id/loadingProgress"
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"/>
        </FrameLayout>
    </LinearLayout>
</ScrollView>