    {
      "parameters": {
        "jsCode": "// === 讀入（有些來源把資料放在 body） ===\nconst raw = items[0].json?.body ?? items[0].json;\n\n// 基本中繼資料（你要傳下去的欄位）\nconst meta = {};\nfor (const k of ['elder_id','session_id','timestamp_ms','lang']) {\n  if (raw && raw[k] != null) meta[k] = raw[k];\n}\n\nconst outputs = [];\n\n// ------------ chat ------------\nif (typeof raw?.message === 'string' && raw.message.trim()) {\n  outputs.push({\n    json: { method: 'talk', ...meta, message: raw.message.trim() }\n  });\n}\n\n// ------------ detect（frames 版）------------\nfunction validFrame(f) {\n  if (!f || typeof f !== 'object') return false;\n  if (['pose','object'].includes(f.type)) return true;\n  if (Array.isArray(f.persons) || Array.isArray(f.detections)) return true;\n  return false;\n}\nfunction toFrames(b) {\n  if (!b) return [];\n  if (Array.isArray(b.frames)) return b.frames.filter(validFrame);\n  if (validFrame(b)) return [b];\n  // 也支援 {pose: {...}, object: {...}} 這種包法\n  const arr = [];\n  if (validFrame(b.pose))   arr.push(b.pose);\n  if (validFrame(b.object)) arr.push(b.object);\n  return arr;\n}\nconst frames = toFrames(raw);\nif (frames.length) {\n  outputs.push({\n    json: { method: 'detect', ...meta, frames }\n  });\n}\n\n// ------------ 都沒有命中 ------------\nif (!outputs.length) {\n  outputs.push({ json: { method: 'unknown', ...meta, raw } });\n}\n\nreturn outputs;\n"
      },
