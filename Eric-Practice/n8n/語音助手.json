    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Merge1 後的 Code（Mode: Run Once for Each Item）\nconst item = $input.item;\n\n// 1) 取本次 Q/A（先從當前 item，沒有再回退到 Code1）\nconst qa = item.json?.current_qa\n        ?? $node['Code1']?.item?.json?.current_qa\n        ?? { Q: '', A: '' };\n\n// 2) URL 編碼給 header 用\nconst enc = s => encodeURIComponent(String(s ?? ''));\nitem.json.encoded_user_text = enc(qa.Q);\nitem.json.encoded_ai_text   = enc(qa.A);\n\n// 3) 確保 binary 還在（保險：若沒有就從 TTS 節點抓）\nif (!item.binary?.data) {\n  const ttsBin = $node['Convert text to speech']?.item?.binary?.data;\n  if (!ttsBin) throw new Error('缺少 audio binary (data)');\n  item.binary = item.binary || {};\n  item.binary.data = ttsBin;\n}\n\n// 補上檔名與 MIME\nitem.binary.data.fileName ??= 'reply.mp3';\nitem.binary.data.mimeType  = 'audio/mpeg';\n\n// ★ 在「Run Once for Each Item」要回傳單一物件，不是陣列\nreturn item;\n"
      },
