    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 取得當前 item（子流程已回來）\nconst it = $input.item;\nconst j  = it.json || {};\n\n// 若子流程已帶 encoded_* 就直接用；否則從 current_qa 補\nconst enc = s => encodeURIComponent(String(s ?? ''));\nif (!j.encoded_user_text || !j.encoded_ai_text) {\n  const q = j.current_qa?.Q ?? j.conversation_log?.current_qa?.Q ?? '';\n  const a = j.current_qa?.A ?? j.conversation_log?.current_qa?.A ?? '';\n  if (!j.encoded_user_text) j.encoded_user_text = enc(q);\n  if (!j.encoded_ai_text)   j.encoded_ai_text   = enc(a);\n}\n\n// 確保 binary 還在（子流程通常放在 binary.data）\nif (!it.binary?.data) throw new Error('missing audio binary (data)');\n\n// （可選）補上檔名/MIME，避免上游沒設好\nit.binary.data.fileName ??= 'reply.mp3';\nit.binary.data.mimeType   = 'audio/mpeg';\n\nreturn { json: j, binary: it.binary };\n"
      },
