      "parameters": {
        "jsCode": "// base：原始輸入（或你的正規化 Code 節點）\nconst base = $item(0).$node['When Executed by Another Workflow'].json;\n// agent：AI Agent 的輸出（只有 {output: ...}）\nconst agent = $json;\n\n// 合併；若有同名鍵，以 agent 覆蓋 base\nreturn [{ ...base, ...agent }];   // 得到 {elder_id, session_id, message, output}"
