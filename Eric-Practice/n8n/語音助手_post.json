    {
      "parameters": {
        "jsCode": "// 取原始輸入句子\nconst base = $item(0).$node['When Executed by Another Workflow'].json;\nconst text = (base.text || '').toLowerCase(); // 中文不用 lower，但保留\n\n// 關鍵字清單\nconst chatKW = ['聊','聊天','聊聊','陪我聊','陪我聊天','陪我說話','說說話','講講話','作伴','陪伴'];\nconst searchKW = ['天氣','新聞','日期','時間','哪裡','地點','地址','路線','電話','台北','臺北','幾點','多少','價格','價錢','匯率','股價','播放','回放','顯示','查','查詢','搜尋','找','列出','統計','紀錄','報表','我的','睡覺','睡眠','步數','影片','收藏','貼文','女兒','兒子','近期','最近','今天','明天'];\n\nconst has = (arr) => arr.some(k => text.includes(k));\n\n// 規則：CHAT 覆蓋 > SEARCH > 預設 CHAT\nconst output = has(chatKW) ? 'chat' : (has(searchKW) ? 'search' : 'chat');\n\n// 把分類結果 + 原始欄位帶下去\nreturn [{ ...base, output }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -80,
        -240
      ],
      "id": "36599415-78c2-4745-8658-dbe7ecb61832",
      "name": "Code"
    },
    {
      "parameters": {
        "jsCode": "// 獲取上一個節點的輸入數據\n// 假設 Q 來自觸發流程的節點，A 來自上一個 AI 節點\nconst elderMessage = $node['When Executed by Another Workflow'].json.text;\nconst aiResponse = $json.output;\n\n// 這是當前的問答，也就是 SQL 節點需要的 \"current_qa\"\nconst currentQA = {\n  Q: elderMessage,\n  A: aiResponse,\n};\n\n// 這是要寫入資料庫的完整對話歷史 (字串格式)\n// 注意：這裡我們假設是「第一次」寫入，所以用 [currentQA]\n// 如果是要「附加」歷史，邏輯會更複雜，但目前先解決 INSERT 的問題\nconst conversationHistoryString = JSON.stringify([currentQA]);\n\n// 將所有下游節點需要的數據，一次性在 return 中提供\nreturn [{\n  // --- 修正 session_id 和 elder_id 的來源 ---\n  elder_id: $node['When Executed by Another Workflow'].json.elder_id,\n  session_id: $node['When Executed by Another Workflow'].json.session_id, // <-- 修正點 1\n\n  // --- 其他欄位 ---\n  start_at: $now.setZone('Asia/Taipei').toFormat('yyyy-LL-dd HH:mm'),\n  conversation_history: conversationHistoryString,\n\n  // --- 新增 current_qa 欄位，供 SQL 節點的 UPDATE 部分使用 ---\n  current_qa: currentQA // <-- 修正點 2\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1968,
        320
      ],
      "id": "bef2a8f1-c773-4524-8ef4-e0bfbcd7bf79",
      "name": "Code1"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO `114-402`.interactions_records (session_id, elder_id, start_at, conversation_history)\nVALUES (\n  {{ $json.session_id }},\n  {{ $json.elder_id }},\n  '{{ $json.start_at }}',\n  JSON_ARRAY(JSON_OBJECT('Q', {{ JSON.stringify($json.current_qa.Q) }}, 'A', {{ JSON.stringify($json.current_qa.A) }}))\n)\nON DUPLICATE KEY UPDATE\n  conversation_history = JSON_ARRAY_APPEND(conversation_history, '$', JSON_OBJECT('Q', {{ JSON.stringify($json.current_qa.Q) }}, 'A', {{ JSON.stringify($json.current_qa.A) }})),\n  start_at = '{{ $json.start_at }}';\n",
        "options": {}
      },
