    {
      "parameters": {
        "jsCode": "// 取原始輸入句子\nconst base = $item(0).$node['When Executed by Another Workflow'].json;\nconst text = (base.text || '').toLowerCase(); // 中文不用 lower，但保留\n\n// 關鍵字清單\nconst chatKW = ['聊','聊天','聊聊','陪我聊','陪我聊天','陪我說話','說說話','講講話','作伴','陪伴'];\nconst searchKW = ['天氣','新聞','日期','時間','哪裡','地點','地址','路線','電話','台北','臺北','幾點','多少','價格','價錢','匯率','股價','播放','回放','顯示','查','查詢','搜尋','找','列出','統計','紀錄','報表','我的','睡覺','睡眠','步數','影片','收藏','貼文','女兒','兒子','近期','最近','今天','明天'];\n\nconst has = (arr) => arr.some(k => text.includes(k));\n\n// 規則：CHAT 覆蓋 > SEARCH > 預設 CHAT\nconst output = has(chatKW) ? 'chat' : (has(searchKW) ? 'search' : 'chat');\n\n// 把分類結果 + 原始欄位帶下去\nreturn [{ ...base, output }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -80,
        -240
      ],
      "id": "36599415-78c2-4745-8658-dbe7ecb61832",
      "name": "Code"
    },
    {
      "parameters": {
        "jsCode": "// 獲取上一個節點的輸入數據\nconst elderMessage = $node['When Executed by Another Workflow'].json.text;\nconst aiResponse = $json.output; // 假設來自前一個 AI Agent 節點的輸出\n\n// 構建您想要的 JSON 格式\nconst conversationEntry = {\n  Q: elderMessage,\n  A: aiResponse,\n};\n\n// 將其轉換為 JSON 字串，以便儲存到資料庫的一個欄位中\n// 如果資料庫欄位類型是 TEXT 或 JSON，可以直接儲存字串\nconst conversationHistory = JSON.stringify([conversationEntry]);\n\n// 將處理後的數據作為新的輸出，傳遞給下一個節點\n// 您可以選擇保留原始數據，或者只輸出新生成的數據\nreturn [{\n  elder_id: $node['When Executed by Another Workflow'].json.elder_id,\n  created_at: $now.setZone('Asia/Taipei').toFormat('yyyy-LL-dd HH:mm'),\n  // 將合併後的對話歷史儲存到一個新的欄位，例如 'conversation_history'\n  conversation_history: conversationHistory,\n  // 如果您還想保留原始的 elder_text 和 ai_text，也可以在這裡添加\n  // elder_text: elderMessage,\n  // ai_text: aiResponse,\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        208
      ],
      "id": "bef2a8f1-c773-4524-8ef4-e0bfbcd7bf79",
      "name": "Code1"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO interactions_records (session_id, elder_id, created_at, conversation_history)\nVALUES (\n  {{ $json.session_id }},\n  {{ $json.elder_id }},\n  '{{ $json.created_at }}',\n  JSON_ARRAY(JSON_OBJECT('Q', {{ JSON.stringify($json.current_qa.Q) }}, 'A', {{ JSON.stringify($json.current_qa.A) }}))\n)\nON DUPLICATE KEY UPDATE\n  conversation_history = JSON_ARRAY_APPEND(conversation_history, '$', JSON_OBJECT('Q', {{ JSON.stringify($json.current_qa.Q) }}, 'A', {{ JSON.stringify($json.current_qa.A) }})),\n  created_at = '{{ $json.created_at }}';",
        "options": {}
